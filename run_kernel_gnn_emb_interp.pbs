#!/bin/bash
#PBS -N kernel_emb_interp
#PBS -q main
#PBS -l select=1:ncpus=4:ngpus=1:mem=32GB
#PBS -l walltime=02:00:00
#PBS -A P93300301
#PBS -l job_priority=premium
#PBS -o /glade/derecho/scratch/advike/graphcast_recon/logs/kernel_emb_interp.out
#PBS -e /glade/derecho/scratch/advike/graphcast_recon/logs/kernel_emb_interp.err

module load cuda/12.9.0
module load conda/latest
source $(conda info --base)/etc/profile.d/conda.sh
conda activate graphcast
cd /glade/derecho/scratch/advike/graphcast_recon
# homoscedastic kernel GNN + GraphCast embeddings (both T & P) + smooth
# mesh->grid IDW interpolation (k=6) -> weights_kernel/best_[TP]_emb_homo_interp6.npz
python3 recon_gnn_kernel.py --epochs 200 --lr 1e-3 --hidden 32 --kernel-dim 32 --mesh-rounds 4 --emb-pca 16 --interp-k 6
